        {
          "key": "intensity",
          "label": "强度",
          "type": "number",
          "default": 0.9,
          "min": 0.0,
          "max": 1.0,
          "step": 0.05
        }
      ],
      "category": "impact",
      "renderer": "flash",
      "supported_from": [
        "video",
        "freeze"
      ],
      "supported_to": [
        "video",
        "freeze"
      ]
    },
